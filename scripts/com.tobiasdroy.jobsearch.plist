<?xml version="1.0" encoding="UTF-8"?>
<!-- Starts the job search app at login. Install:
     cp scripts/com.tobiasdroy.jobsearch.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.tobiasdroy.jobsearch.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tobiasdroy.jobsearch</string>
  <key>WorkingDirectory</key><string>/Users/tobiasdroy/Desktop/Job Search Agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/tobiasdroy/Desktop/Job Search Agent/.venv/bin/uvicorn</string>
    <string>jobsearch.web:app</string>
    <string>--port</string><string>8765</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- claude, tectonic and pdftotext must be on PATH for CV tailoring -->
    <key>PATH</key><string>/Users/tobiasdroy/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/jobsearch.log</string>
  <key>StandardErrorPath</key><string>/tmp/jobsearch.log</string>
</dict>
</plist>
